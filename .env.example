# ==============================================================================
# BREW & BLISS COFFEE HOUSE - ENVIRONMENT VARIABLES TEMPLATE
# Salin file ini menjadi .env.local lalu isi sesuai kredensial Anda.
# ==============================================================================

# 1. Neon Serverless PostgreSQL (Wajib)
# Dapatkan dari Neon Console -> Connection Details (Pooled / Direct)
DATABASE_URL="postgresql://user:password@ep-example-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# 2. Cloud Object Storage - Primary: Vercel Blob (Direkomendasikan)
# Dapatkan dari Vercel Dashboard -> Storage -> Blob
BLOB_READ_WRITE_TOKEN=""

# 3. Cloud Object Storage - Alternatif: Cloudflare R2 (S3-Compatible)
# Jika BLOB_READ_WRITE_TOKEN kosong dan kredensial R2 diisi, upload otomatis ke Cloudflare R2.
# Jika keduanya kosong (mode dev lokal), gambar disimpan ke /public/uploads.
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME=""
# R2_PUBLIC_URL="https://pub-xxxxxxxxxxxxxxxx.r2.dev"

# 4. Keamanan & Autentikasi Admin (/admin)
# Gunakan string acak minimal 32 karakter untuk menandatangani cookie JWT
JWT_SECRET="ganti-dengan-string-acak-minimal-32-karakter-rahasia"

# 5. Akun Admin Default (digunakan oleh npm run db:seed & fallback login awal)
ADMIN_DEFAULT_EMAIL="admin@coffee.id"
ADMIN_DEFAULT_PASSWORD="BrewBlissAdmin2026!"
